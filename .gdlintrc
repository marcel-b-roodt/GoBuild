# gdlint configuration for GoBuild — YAML format
# https://github.com/Scony/godot-gdscript-toolkit

max-line-length: 100

# SelectionManager exposes ~20 small public methods (select/deselect/toggle 3
# element types + mode + bulk helpers).  Raise the cap rather than forcing
# artificial restructuring of a cohesive API.
# GdUnit4 test suites also accumulate many public test_ methods by design;
# 70 is generous enough for any test class while still catching bloated
# production classes.
max-public-methods: 70

# GoBuildGizmoPlugin grows legitimately: it owns all gizmo materials, cached
# meshes, drag-math methods (translate, rotate, plane, scale, viewport-plane,
# inset), and mesh-builder statics.  GoBuildPanel accumulates handler methods
# for each new operation section (UV, Surface, Materials, …).  2200 lines is a
# generous ceiling; when Stage 5 is complete, extract panel handler groups into
# dedicated RefCounted helpers to bring both files back under ~1000 lines.
max-file-lines: 2200

# _handle_param_preview_input routes keyboard-cancel, motion, and three mouse-
# button cases — each branch needs its own early return.  Nine returns is still
# well-reasoned; do not force an artificial helper split.
max-returns: 10
